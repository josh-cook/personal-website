{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "vitest"],
  "env": { "browser": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["build"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
